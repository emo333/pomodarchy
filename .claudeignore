# Prevent the agent from viewing system paths and credentials
.git/
.env
.env.*
*key*
*secret*
*token*
credentials.json
.git-credentials
.netrc
.npmrc
.pypirc
.envrc
*.env
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.ssh/
.aws/
.kube/
.secrets/
secrets/
.pi/

# Prevent the agent from choking on massive dependency files
node_modules/
vendor/
.next/
.nuxt/
dist/
build/
out/
target/
*.exe
*.dll
*.so
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Logs and system artifacts
*.log
.npm/
.yarn/
Thumbs.db
Desktop.ini
