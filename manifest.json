{
  "schemaVersion": 1,
  "id": "emo333.pomodarchy",
  "name": "Pomodarchy",
  "version": "1.0.0",
  "author": "emo333",
  "license": "MIT",
  "repository": "https://github.com/emo333/pomodarchy",
  "description": "A configurable Pomodoro timer for the Omarchy bar.",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "Pomodarchy",
    "description": "A glanceable Pomodoro timer with phase controls.",
    "category": "Productivity",
    "defaultSection": "right",
    "allowMultiple": false,
    "defaults": {
      "focusMinutes": 30,
      "shortBreakMinutes": 5,
      "longBreakMinutes": 30,
      "longBreakEvery": 4,
      "soundEnabled": true,
      "focusEndSound": "assets/focus-complete.wav",
      "breakEndSound": "assets/break-complete.wav",
      "soundVolume": 50
    },
    "schema": [
      {
        "key": "focusMinutes",
        "type": "integer",
        "label": "Focus duration (minutes)",
        "min": 1,
        "max": 1440,
        "step": 1,
        "defaultValue": 30
      },
      {
        "key": "shortBreakMinutes",
        "type": "integer",
        "label": "Short break duration (minutes)",
        "min": 1,
        "max": 1440,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "longBreakMinutes",
        "type": "integer",
        "label": "Long break duration (minutes)",
        "min": 1,
        "max": 1440,
        "step": 1,
        "defaultValue": 30
      },
      {
        "key": "longBreakEvery",
        "type": "integer",
        "label": "Focus sessions between long breaks",
        "min": 1,
        "max": 100,
        "step": 1,
        "defaultValue": 4
      },
      {
        "key": "soundEnabled",
        "type": "boolean",
        "label": "Completion sound",
        "defaultValue": true,
        "description": "Play a sound when a phase reaches zero. Sound is skipped while Do Not Disturb is detected."
      },
      {
        "key": "focusEndSound",
        "type": "path",
        "label": "Focus end sound",
        "defaultValue": "assets/focus-complete.wav",
        "description": "Clip played when a focus phase ends. Uses the included original focus chime by default; users may choose another audio file."
      },
      {
        "key": "breakEndSound",
        "type": "path",
        "label": "Break end sound",
        "defaultValue": "assets/break-complete.wav",
        "description": "Clip played when a short or long break ends. Uses the included original break chime by default; users may choose another audio file."
      },
      {
        "key": "soundVolume",
        "type": "integer",
        "label": "Completion sound volume (%)",
        "min": 0,
        "max": 100,
        "step": 5,
        "defaultValue": 50,
        "description": "Playback volume for the end-of-phase clip. 0 is silent and 100 is the stream's normal level."
      }
    ]
  }
}
